{
  "expo": {
    "name": "Landshop Nigeria",
    "slug": "landshop-customer",
    "scheme": "landshop",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.landshopnigeria.customer"
    },
    "android": {
      "package": "com.landshopnigeria.customer",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Landshop uses selected photos only when you upload an identity document.",
          "cameraPermission": "Landshop uses the camera to capture your KYC selfie for identity review.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "environment": "production"
    }
  }
}
